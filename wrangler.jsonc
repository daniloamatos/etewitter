{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "etewitter",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "EtewitterContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ETEWITTER_CONTAINER",
        "class_name": "EtewitterContainer"
      }
    ]
  },
  "exports": {
    "EtewitterContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
